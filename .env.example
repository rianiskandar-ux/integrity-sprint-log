# =============================================================================
# ISL (Integrity Sprint Log) — konfigurasi per-orang (Model B: tiap orang
# jalanin instance sendiri di laptop/PC masing-masing).
#
# CARA PAKAI:
#   1. Copy file ini jadi ".env"   →   cp .env.example .env   (atau pakai scripts/setup-isl.ps1)
#   2. Isi nilai di bawah sesuai punya kamu.
#   3. JANGAN commit file .env (sudah di .gitignore).
# =============================================================================

# --- OpenProject (WAJIB) -----------------------------------------------------
# URL instance OpenProject tim.
OP_BASE_URL=https://tokek.integrity-asia.com
# Token API OP KAMU SENDIRI. Ambil: OpenProject → My Account → Access Tokens → API.
# Catatan: di mode multi-user (default), kamu login pakai token ini lewat halaman /login,
# jadi field ini boleh dikosongkan. Diisi hanya kalau pakai single-user (ISL_MULTIUSER=0).
OP_API_TOKEN=
# Project default untuk auto-tagging.
OP_PROJECT_ID=integritys-websites

# --- Mode akses --------------------------------------------------------------
# 1 = multi-user (login pakai OP token via /login). DISARANKAN — kamu jadi owner instance-mu.
# 0 = single-user (langsung pakai OP_API_TOKEN di atas, tanpa login). Kalau 0, isi ISL_OP_USER_ID.
ISL_MULTIUSER=1
# Hanya dipakai kalau ISL_MULTIUSER=0 — OP user id kamu (angka, dari OP /users/me).
ISL_OP_USER_ID=0
# Internal uid pemilik markdown lama (daily-sprints/). Biarkan 1 untuk instance baru (kamu = user pertama).
ISL_OWNER_UID=1

# --- Kredensial Claude Code (untuk AI Chat / claude-cli, GRATIS pakai subscription) ---
# Folder .claude milikmu di host. Default Windows: C:/Users/NAMAKAMU/.claude
# scripts/setup-isl.ps1 bisa auto-isi ini dari $env:USERPROFILE.
CLAUDE_CREDS_DIR=C:/Users/NAMAKAMU/.claude
CLAUDE_CONFIG_FILE=C:/Users/NAMAKAMU/.claude.json

# --- Keamanan (WAJIB diganti — unik per orang) -------------------------------
# Kunci enkripsi at-rest untuk secret (AES-256). GANTI ke string acak panjang.
# Generate: scripts/setup-isl.ps1, atau: openssl rand -hex 32
ISL_ENCRYPTION_KEY=ganti-dengan-kunci-acak-unik-min-32-char
# Secret session cookie. Ganti juga.
NEXTAUTH_SECRET=ganti-dengan-secret-acak
# Password Postgres lokal (instance kamu sendiri, boleh apa saja).
POSTGRES_PASSWORD=isl-local-2026
# PIN gate opsional (kosong = nonaktif).
ISL_ACCESS_PIN=

# --- Google Calendar (OPSIONAL) ----------------------------------------------
# Kosongkan kalau tidak pakai integrasi Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_HINT=
GOOGLE_REDIRECT_URI=http://localhost:4891/api/auth/callback/google

# --- AI Chat cloud providers (OPSIONAL — default pakai Claude CLI yang gratis) ---
# Isi key sendiri kalau mau pakai model cloud (TokenRouter/OpenModel). Kosong = cuma Claude CLI.
AI_CHAT_TR_KEY=
AI_CHAT_TR_BASE=https://api.tokenrouter.com/v1
AI_CHAT_OM_KEY=
AI_CHAT_OM_BASE=https://api.openmodel.ai/v1
